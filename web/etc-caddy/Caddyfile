# The Caddyfile is an easy way to configure your Caddy web server.
#
# Unless the file starts with a global options block, the first
# uncommented line is always the address of your site.
#
# To use your own domain name (with automatic HTTPS), first make
# sure your domain's A/AAAA DNS records are properly pointed to
# this machine's public IP, then replace ":80" below with your
# domain name.

https://ghostland.ovh, https://ghostland.ovh:443, ghostland.ovh:443, http://ghostland.ovh, http://ghostland.ovh:80, ghostland.ovh:80, ghostland.ovh, https://localhost, https://localhost:443, localhost:443, http://localhost, http://localhost:80, localhost:80, localhost, https://91.189.34.187, https://91.189.34.187:443, 91.189.34.187:443, http://91.189.34.187, http://91.189.34.187:80, 91.189.34.187:80, 91.189.34.187 {
    
    handle_path /modules/* {
        
        # FS-based modules (those, that get mounted in docker-compose.yml) [only CI right now]
        root * /srv
        encode
        file_server browse {
            hide /srv/ci/latest_server.mrpack 
        }
        
        # For modules hosted as complete web servers by different services [only Create Track Map right now]
        reverse_proxy /railwaymap/* localhost:3876
        
        redir / / permanent # Looks very stupid, but basically the first / means „modules/” (because prefixes are stripped), while the second is just "/" or the website root - in other words: this redirects from [URL]/modules/ to [URL]/
    }
    
    handle {
        reverse_proxy /* localhost:3000
    }
}

# Refer to the Caddy docs for more information:
# https://caddyserver.com/docs/caddyfilex